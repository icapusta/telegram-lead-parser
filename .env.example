# --- Telegram Settings ---
# Get these from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=79000000000

# --- n8n Settings ---
# URL where the parser sends data (now: our own parser service, not n8n)
# Example:
# N8N_WEBHOOK_URL=https://parser.tunecrm.ru/api/ingest/tg-monitor
N8N_WEBHOOK_URL=https://parser.tunecrm.ru/api/ingest/tg-monitor

# --- General Settings (Traefik) ---
DOMAIN_NAME=example.com
SSL_EMAIL=admin@example.com

# --- Parser Service Settings ---
# CLIProxyAPI (OpenAI-compatible)
CLIPROXY_BASE_URL=https://cliproxi.tunecrm.su/v1
CLIPROXY_API_KEY=vscode

# Telegram bot notifications
TG_BOT_TOKEN=
TG_CHAT_ID=
